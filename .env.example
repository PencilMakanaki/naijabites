# Copy this file to .env and fill it in. Never commit .env or share it.

NODE_ENV=development
PORT=3000
# The address people use to open the site. Used for the CSRF origin check.
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (0 when none).
TRUST_PROXY=0

# Database (the Docker setup in this project uses port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=naijabites
# The app's own limited user (data changes only)
DB_USER=naijabites_app
DB_PASSWORD=app_dev_only_change_me
# The migration user (can change the structure). Falls back to DB_USER when empty.
DB_MIGRATOR_USER=naijabites_migrator
DB_MIGRATOR_PASSWORD=migrator_dev_only_change_me

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=

# Session lifetimes
SESSION_DAYS_CUSTOMER=30
SESSION_HOURS_STAFF=12

# Email (sign-up confirmation, password reset). Leave SMTP_HOST empty while developing:
# the emails, with their links, are then written to the server window instead of being sent.
# In production an email provider is required.
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=NaijaBites <no-reply@naijabites.local>

# Optional server-side Google Routes API key (never expose in the browser).
GOOGLE_ROUTES_API_KEY=
